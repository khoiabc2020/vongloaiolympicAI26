        <mxCell id="arrow_into_result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endSize=6;endFill=1;" edge="1" parent="1" target="result_box">
